# Flow configuration
FLOW_DATA_DIR=./data
FLOW_DATABASE_URL=sqlite:///./data/flow.sqlite
FLOW_DEFAULT_PROJECT=default
FLOW_HOST=0.0.0.0
FLOW_PORT=8100
FLOW_DEBUG=false
FLOW_THEME=neutral

# Trusted headers (set to true ONLY if behind a reverse proxy that strips X-Axis-* headers)
FLOW_TRUSTED_HEADERS=false
