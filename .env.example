# Flow configuration
FLOW_DATA_DIR=./data
FLOW_DATABASE_URL=sqlite:///./data/flow.sqlite
FLOW_DEFAULT_PROJECT=default
FLOW_HOST=0.0.0.0
FLOW_PORT=8100
FLOW_DEBUG=false
FLOW_THEME=neutral

# External base URL advertised by GET /llms.txt (the single link you hand an agent).
# Leave unset to derive it from each incoming request; set it when behind a reverse proxy.
# FLOW_PUBLIC_URL=https://flow.example.com

# Trusted headers (set to true ONLY if behind a reverse proxy that strips X-Axis-* headers)
FLOW_TRUSTED_HEADERS=false

# Web session cookie secret for browser login. `flow-serve` auto-generates and persists one in the
# data dir, so you usually don't need to set this. Set it explicitly to share sessions across
# multiple instances or to rotate on demand.
# FLOW_SESSION_SECRET=
# Set to true in production (HTTPS) so the session cookie is only sent over secure connections
# FLOW_SESSION_COOKIE_SECURE=false

# Runner configuration (for flow-runner service or python -m flow_app.runner)
# Comma-separated agent profile names to dispatch on each pass
# FLOW_RUNNER_PROFILES=hermes-delegator
# Seconds between runner passes (default: 30)
# FLOW_RUNNER_INTERVAL=30
# Flow API base URL for subprocess dispatch (default: http://127.0.0.1:8100)
# FLOW_BASE_URL=http://127.0.0.1:8100
# Flow API key with implementer or admin role
# FLOW_API_KEY=
# Dry-run mode: log what would happen without executing (default: false)
# FLOW_RUNNER_DRY_RUN=false
